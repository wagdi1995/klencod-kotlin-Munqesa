<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark shadow bottom-right -->
    <item android:left="0dp" android:top="0dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#C8D0DB" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <!-- White highlight top-left -->
    <item android:left="4dp" android:top="4dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <!-- Base capsule surface -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#EDF1F6" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
